{{> layout/header}}

<style>
    /* 반응형: 모바일 화면 스타일 */
    @media (max-width: 767.98px) {
        i.fs-5 {
            font-size: 1rem !important;
        }
    }
</style>

<div class="wrapper">
    <div class="content">
        <div class="container my-5" style="max-width: 1200px;">
            <!-- 페이지 헤더 -->
            <div class="d-flex justify-content-between align-items-center mb-1">
                <h1 class="text-truncate h4 text-muted"
                    title="{{member.username}}님의 이력서 목록입니다. 모두 {{totalCount}}개의 이력서가 있습니다.">
                    {{member.username}}님의 이력서 목록 (총 {{totalCount}}개)
                </h1>
                <a href="/resume/save-form" class="btn btn-outline-primary text-nowrap" title="새 이력서 작성하러 가기">
                    <i class="fa-solid fa-plus me-2"></i>
                    이력서 작성
                </a>
            </div>
            <hr>

            <!-- 대표 이력서 섹션 -->
            {{#repResume}}
                <div class="card border-primary shadow-sm mt-3 mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1" style="min-width: 0;">
                                <a href="/resume/{{resumeIdx}}" class="text-decoration-none">
                                    <h5 class="text-truncate card-title mb-1 text-primary fw-bold">{{resumeTitle}}</h5>
                                </a>
                                <p class="card-text"><small class="text-muted">작성일: {{createdAtFormatted}}</small></p>
                                <pre class="text-truncate card-text text-muted mt-1">{{shortContent}}</pre>
                            </div>
                            <div class="flex-shrink-0 ms-3">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge text-primary p-0 fs-5" title="대표 이력서입니다.">
                                        <i class="fa-solid fa-trophy"></i>
                                        <span class="d-none d-md-inline"> 대표 이력서</span>
                                    </span>
                                    <a href="/resume/{{resumeIdx}}/update-form" class="text-primary" title="수정하기">
                                        <i class="fa-solid fa-pen-to-square fs-5"></i>
                                    </a>

                                    <!-- 범용 확인 스크립트 적용 -->
                                    <form class="confirm-form d-inline" action="/resume/{{resumeIdx}}/delete" method="post"
                                          data-confirm-template="'{itemName}' 이력서를 정말로 {action}하시겠습니까?"
                                          data-item-name="{{resumeTitle}}" data-action="삭제">
                                        <button type="submit" class="btn btn-link p-0" title="삭제하기"
                                                style="color: Tomato !important;">
                                            <i class="fa-solid fa-trash fs-5"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {{/repResume}}

            <!-- 일반 이력서 목록 -->
            <div class="row row-cols-1 gy-3">
                {{#resumePage.content}}
                    <hr class="mt-3 mb-0">
                    <div class="col">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1" style="min-width: 0;">
                                        <a href="/resume/{{resumeIdx}}" class="text-decoration-none">
                                            <h5 class="text-truncate card-title mb-1 text-muted">{{resumeTitle}}</h5>
                                        </a>
                                        <p class="card-text">
                                            <small class="text-muted">작성일: {{createdAtFormatted}}</small>
                                        </p>
                                        <pre class="text-truncate card-text text-muted mt-1">{{shortContent}}</pre>
                                    </div>
                                    <div class="flex-shrink-0 ms-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <!-- 범용 확인 스크립트 적용 (대표 설정) -->
                                            <form class="confirm-form d-inline" action="/resume/{{resumeIdx}}/set-rep" method="post"
                                                  data-confirm-template="'{itemName}' 이력서를 대표 이력서로 {action}하시겠습니까?"
                                                  data-item-name="{{resumeTitle}}" data-action="설정">
                                                <button type="submit" class="btn btn-link text-primary p-0"
                                                        title="대표 이력서로 설정">
                                                    <i class="fa-regular fa-star fs-5"></i>
                                                </button>
                                            </form>
                                            <a href="/resume/{{resumeIdx}}/update-form" class="text-primary"
                                               title="수정하기">
                                                <i class="fa-solid fa-pen-to-square fs-5"></i>
                                            </a>
                                            <!-- 범용 확인 스크립트 적용 (삭제) -->
                                            <form class="confirm-form d-inline" action="/resume/{{resumeIdx}}/delete" method="post"
                                                  data-confirm-template="'{itemName}' 이력서를 정말로 {action}하시겠습니까?"
                                                  data-item-name="{{resumeTitle}}" data-action="삭제">
                                                <button type="submit" class="btn btn-link p-0" title="삭제하기"
                                                        style="color: Tomato !important;">
                                                    <i class="fa-solid fa-trash fs-5"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {{/resumePage.content}}

                <!-- 이력서 없음 메시지 -->
                {{^repResume}}
                    {{#resumePage.empty}}
                        <div class="col">
                            <div class="text-center py-5">
                                <p class="mb-0">작성된 이력서가 없습니다. 새 이력서를 작성해 보세요.</p>
                            </div>
                        </div>
                    {{/resumePage.empty}}
                {{/repResume}}
            </div>

            <!-- 페이지네이션 -->
            <nav class="mt-4" aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    {{#navigation.hasPrev}}
                        <li class="page-item">
                            <a class="page-link" href="?page={{navigation.prevPage}}" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    {{/navigation.hasPrev}}
                    {{^navigation.hasPrev}}
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                    {{/navigation.hasPrev}}

                    {{#navigation.pageNumbers}}
                        <li class="page-item {{#current}}active{{/current}}">
                            <a class="page-link" href="?page={{number}}">{{displayNumber}}</a>
                        </li>
                    {{/navigation.pageNumbers}}

                    {{#navigation.hasNext}}
                        <li class="page-item">
                            <a class="page-link" href="?page={{navigation.nextPage}}" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    {{/navigation.hasNext}}
                    {{^navigation.hasNext}}
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    {{/navigation.hasNext}}
                </ul>
            </nav>

        </div>
    </div>
</div>

{{> layout/footer}}